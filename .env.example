# ============================================================
# NIGHTVAULT SUPABASE CONFIGURATION
# ============================================================
# 1. Create a project at https://supabase.com
# 2. Run the SQL script located in 'supabase/schema.sql' in Supabase's SQL Editor
# 3. Copy your Project URL and anon public API key from Project Settings -> API
# 4. Rename this file to .env.local or paste them directly into Nightvault's Settings UI!

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here
